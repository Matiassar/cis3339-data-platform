# Copy this file to backend/.env and fill in real values.
# For grading, the working .env is submitted separately via Canvas (not committed).

# MongoDB connection string, including the database name (dataplatform).
# The mongodb:// form (listing the shard hosts) avoids the querySrv DNS error on some networks.
MONGO_URL=mongodb://<db_user>:<db_password>@<host>/dataplatform?ssl=true&authSource=admin&retryWrites=true&w=majority

# Port the API listens on
PORT=3000

# 24-character hex id of the organization this instance serves
ORG_ID=<24_char_hex_org_id>

# Secret used to sign and verify login tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<long_random_string>

# The frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Demo accounts created by `npm run seed:dev` (passwords are bcrypt-hashed before storage)
SEED_VIEWER_USERNAME=user
SEED_VIEWER_PASSWORD=user
SEED_EDITOR_USERNAME=admin
SEED_EDITOR_PASSWORD=admin